# Local MongoDB credentials for development container
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123
MONGO_INITDB_DATABASE=portfolio_dev

# Optional URI to connect to local Mongo container (use this in server env if desired)
MONGO_URI=mongodb://admin:admin123@mongo:27017/portfolio_dev?authSource=admin
# mongodb+srv://YannickNjilo:taxwor-kekSi6@cluster0.hthyvct.mongodb.net/?appName=Cluster0

# Monitoring access
MONGO_EXPRESS_PORT=8081

CLIENTPORT=3000
SERVERPORT=5000
NODE_ENV=development
CHOKIDAR_USEPOLLING=true

REACT_APP_API_URL=http://localhost:5000/api

ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_ADMINPASSWORD=admin123
ME_CONFIG_MONGODB_SERVER=mongo
ME_CONFIG_MONGODB_PORT=27017
ME_CONFIG_MONGODB_AUTH_DATABASE=admin
ME_CONFIG_MONGODB_URL="mongo://mongo:27017"
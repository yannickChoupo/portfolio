{
  "name": "portfolio-backend",
  "author": "Yannick njilo",
  "license": "ISC",
  "version": "1.0.0",
  "description": "backend starter with node js and mongodb services",
  "main": "index.ts",
  "scripts": {
    "start": "NODE_OPTIONS=--no-deprecation node dist/index.js",
    "build": "tsc",
    "dev": "nodemon --exec ts-node ./src/index.ts",
    "dev-local": "nodemon --exec \"ts-node -r dotenv/config ./src/index.ts dotenv_config_path=.env.dev\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^5.13.6",
    "multer": "2.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "2.4.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^8.5.5",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "2.2.0",
    "@types/node": "^26.2.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
